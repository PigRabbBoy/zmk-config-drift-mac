// Drift V3 (Timception) - macOS keymap
// Based on the upstream Timception/zmk-config-drift-v3-editor default keymap.
//
// Differences from upstream, all macOS-driven:
//   * Copy/Paste use LG() (Command) instead of LC() (Control).
//   * The 2u cap engraved "Shift" on the left outer column is LSHFT (upstream had LGUI there).
//   * Command (LGUI) moved to the outer left thumb, where macOS shortcuts are most comfortable.
//   * The cap engraved "Shift" on the right bottom row is RSHFT (upstream had RALT).
//   * "Pgup"/"Pgdn" caps on the left outer column now actually send PG_UP / PG_DN.
//   * Windows snipping tool shortcut replaced with macOS screenshot shortcuts on the lower layer.
//   * Lower layer adds LC(SPACE) for macOS input-source switching (Thai <-> English).

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120   // default: 10 - for encoder mouse-scroll to work

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";

            // ---------------------------------------------------------------------------------------------------------------------------
            // | ESC   | PGUP | `     |  1  |  2  |  3  |  4  |  5  |               |  6  |  7  |  8  |  9  |  0  |  -  |  =  | BSPC (mac ⌫)|
            // | ⌘C    | PGDN | TAB   |  Q  |  W  |  E  |  R  |  T  |               |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |  \          |
            //         | SHIFT (2u)   |  A  |  S  |  D  |  F  |  G  |               |  H  |  J  |  K  |  L  |  ;  |  '  | ENTER           |
            // | ⌘V    | CTRL | OPT   |  Z  |  X  |  C  |  V  |  B  | MUTE | | MUTE |  N  |  M  |  ,  |  .  |  /  |RSHFT| R⌘  | FWD DEL     |
            //                                    | ⌘   | SPC | LOWER |             |RAISE| SPC | BSPC |

            bindings = <
&kp ESC    &kp PG_UP  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                              &kp N6  &kp N7     &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC
&kp LG(C)  &kp PG_DN  &kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                               &kp Y   &kp U      &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH
           &kp LSHFT  &kp CAPS   &kp A   &kp S   &kp D   &kp F   &kp G                               &kp H   &kp J      &kp K      &kp L    &kp SEMI  &kp SQT    &kp ENTER
&kp LG(V)  &kp LCTRL  &kp LALT   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp C_MUTE      &kp C_MUTE  &kp N   &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT  &kp RGUI   &kp DEL
                                                 &kp LGUI  &kp SPACE  &mo LOWER                      &mo RAISE  &kp SPACE  &kp BSPC
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "lower";

            // ---------------------------------------------------------------------------------------------------------------------------
            // | BOOTLDR | ⌘⇧4 (area shot) | ` | F1 | F2 | F3 | F4 | F5 |          | F6 | F7 | F8 | F9 | F10 | F11 | F12 | FWD DEL |
            // | ⌘⇧5     | ⌘⇧3 (full shot) |                                        |                  | ⌘←  | ⌘→  |                 |
            //           | ^SPACE (input source switch)                            |                              | UP              |
            // |                                                                   |            | LEFT | DOWN | RIGHT               |

            bindings = <
&bootloader     &kp LG(LS(N4))  &kp GRAVE      &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                              &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11       &kp F12        &kp DEL
&kp LG(LS(N5))  &kp LG(LS(N3))  &trans         &trans  &trans  &trans  &trans  &trans                              &trans   &trans   &trans   &trans   &trans   &kp LG(LEFT)  &kp LG(RIGHT)  &trans
                &trans          &kp LC(SPACE)  &trans  &trans  &trans  &trans  &trans                              &trans   &trans   &trans   &trans   &trans   &trans        &kp UP
&trans          &trans          &trans         &trans  &trans  &trans  &trans  &trans  &kp C_MUTE      &kp C_MUTE  &trans   &trans   &trans   &trans   &trans   &kp LEFT      &kp DOWN       &kp RIGHT
                                                        &trans  &trans  &trans                                     &trans   &trans   &kp DEL
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "raise";

            // ---------------------------------------------------------------------------------------------------------------------------
            // | BT CLR | BT CLR ALL |    | BT1 | BT2 | BT3 | BT4 | BT5 |          | BRI- | BRI+ |   |   | PREV | PLAY | NEXT | BOOTLDR |
            // | ⌘SPACE (spotlight)                                                |                       | MCLK | SCRL- | RCLK      |
            //                                                                     |                       | LCLK | MOUSE UP          |
            // |                                                                   |            | MOUSE L | MOUSE D | MOUSE R         |

            bindings = <
&bt BT_CLR     &bt BT_CLR_ALL  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &kp C_BRI_DN  &kp C_BRI_UP  &trans  &trans  &kp C_PREV  &kp C_PP        &kp C_NEXT      &bootloader
&kp LG(SPACE)  &trans          &trans  &trans        &trans        &trans        &trans        &trans                                     &trans        &trans        &trans  &trans  &trans      &mkp MCLK       &msc SCRL_DOWN  &mkp RCLK
               &trans          &trans  &trans        &trans        &trans        &trans        &trans                                     &trans        &trans        &trans  &trans  &trans      &mkp LCLK       &mmv MOVE_UP
&trans         &trans          &trans  &trans        &trans        &trans        &trans        &trans        &kp C_MUTE      &kp C_MUTE  &trans        &trans        &trans  &trans  &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
                                                                    &trans        &trans        &trans                                    &trans        &trans        &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adjust_layer {
            display-name = "adjust";

            // ---------------------------------------------------------------------------------------------------------------------------
            // | BOOTLDR | RESET |   | BT1 | BT2 | BT3 | BT4 | BT5 |               | USB | BLE | TOGGLE |   |   |   | RESET | BOOTLDR |

            bindings = <
&bootloader  &sys_reset  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                              &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans  &trans  &trans  &sys_reset  &bootloader
&trans       &trans      &trans  &trans        &trans        &trans        &trans        &trans                                     &trans        &trans        &trans        &trans  &trans  &trans  &trans      &trans
             &trans      &trans  &trans        &trans        &trans        &trans        &trans                                     &trans        &trans        &trans        &trans  &trans  &trans  &trans
&trans       &trans      &trans  &trans        &trans        &trans        &trans        &trans        &kp C_MUTE      &kp C_MUTE  &trans        &trans        &trans        &trans  &trans  &trans  &trans      &trans
                                                              &trans        &trans        &trans                                    &trans        &trans        &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
