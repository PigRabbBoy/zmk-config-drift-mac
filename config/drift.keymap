// Drift V3 (Timception) dongle build - macOS keymap
// Based on the upstream Timception/drift-v3-dongle default keymap.
//
// Five layers. Numbering matters: `game` is a toggled overlay and sits BELOW the
// held layers so that holding nav/mouse while a game is on still wins.
//
//   0 base   - everyday typing and macOS shortcuts. Every key is a plain key:
//              no hold-taps, no combos (Thai Kedmanee leans on Shift, games need
//              plain keys, and the board-check page is slot-indexed - ADR-0004).
//   1 game   - toggled with adjust+G, stays on until toggled off (ADR-0003).
//              Changes only WASD (last-input-priority SOCD from Timception's
//              key-press-lip module) and the outer left thumb, Command -> Option,
//              so a stray Command cannot quit or hide the game. Everything else
//              passes through to base.
//   2 nav    - hold the inner left thumb. HJKL arrows under the right hand,
//              Home/PgDn/PgUp/End above them, F-keys on the number row, macOS
//              window keys under the left hand, caps_word on the Caps slot.
//              Word / line jumps, selection and window tiling come from holding
//              the real Option / Command / Shift / Control keys over the arrows,
//              so those slots stay &trans on purpose.
//   3 mouse  - hold the inner right thumb. WASD moves the pointer (left hand,
//              like a game), the left thumbs click, F is middle click, N/M are
//              mouse buttons 4/5, and the encoders scroll: left up/down, right
//              left/right. Acceleration only, no precision layer yet.
//   4 adjust - nav + mouse together. Bluetooth, USB/BLE output, media,
//              brightness, real Caps Lock, screen lock, bootloader, game toggle.
//
// Differences from upstream, all macOS-driven:
//   * Copy/Paste use LG() (Command) instead of LC() (Control).
//   * The 2u cap engraved "Shift" on the left outer column is LSHFT (upstream had LGUI).
//   * Command (LGUI) sits on the outer left thumb, where macOS shortcuts are comfortable.
//   * The cap engraved "Shift" on the right bottom row is RSHFT (upstream had BACKSPACE).
//   * "Pgup"/"Pgdn" caps on the left outer column actually send PG_UP / PG_DN.
//   * The cap engraved "Caps" sends Control+Space, macOS's input-source switch
//     (Thai <-> English). Real Caps Lock lives on adjust.
//   * Windows snipping shortcut replaced with macOS screenshot shortcuts on nav.
//   * Right encoder press is play/pause; the left one still mutes.

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4500  // default: 600 - pointer max speed on the mouse layer
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120   // default: 10 - for encoder mouse-scroll to work

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define GAME   1
#define NAV    2
#define MOUSE  3
#define ADJUST 4

// Pointer keys start slow and ramp up, so a tap nudges and a hold travels.
&mmv {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <1>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV MOUSE>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        /* Setup left and right */
        kpad: key_lip_a_d {
            compatible = "zmk,behavior-key-press-lip";
            #binding-cells = <1>;
            keycodes = <A D>;
        };

        /* Setup up and down */
        kpws: key_lip_w_s {
            compatible = "zmk,behavior-key-press-lip";
            #binding-cells = <1>;
            keycodes = <W S>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";

            // ---------------------------------------------------------------------------------------------------------------------------
            // | ESC   | PGUP | `     |  1  |  2  |  3  |  4  |  5  |               |  6  |  7  |  8  |  9  |  0  |  -  |  =  | BSPC (mac ⌫)|
            // | ⌘C    | PGDN | TAB   |  Q  |  W  |  E  |  R  |  T  |               |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |  \          |
            //         | SHIFT (2u)   | ^SPC |  A  |  S  |  D  |  F  |  G  |        |  H  |  J  |  K  |  L  |  ;  |  '  | ENTER           |
            // | ⌘V    | CTRL | OPT   |  Z  |  X  |  C  |  V  |  B  | MUTE | | PLAY |  N  |  M  |  ,  |  .  |  /  |RSHFT| R⌘  | FWD DEL     |
            //                                    | ⌘   | SPC | NAV   |             |MOUSE| SPC | BSPC |

            bindings = <
&kp ESC    &kp PG_UP      &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                            &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC
&kp LG(C)  &kp PG_DN      &kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                             &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH
           &kp LSHFT      &kp LC(SPACE)      &kp A   &kp S   &kp D   &kp F   &kp G                     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT    &kp ENTER
&kp LG(V)  &kp LCTRL      &kp LALT   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp C_MUTE    &kp C_PP    &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT  &kp RGUI   &kp DEL
                                                     &kp LGUI  &kp SPACE  &mo NAV                     &mo MOUSE  &kp SPACE  &kp BSPC
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            display-name = "game";

            // Toggled overlay (adjust + G). Only WASD and the outer left thumb differ.
            // ---------------------------------------------------------------------------------------------------------------------------
            // |       |      |       |     | W* |     |     |     |               |     |     |     |     |     |     |     |             |
            //         |              |      | A* | S* | D* |     |     |          |     |     |     |     |     |     |                 |
            //                                    | ⌥   |     |       |             |     |     |      |      * = last-input-priority

            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans                            &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &kpws W  &trans   &trans  &trans                            &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &kpad A  &kpws S  &kpad D  &trans  &trans                            &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans  &kp C_MUTE    &kp C_PP    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                   &kp LALT  &trans  &trans                  &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "nav";

            // Hold the inner left thumb. Everything not listed is &trans so that a
            // real Option / Command / Shift / Control held alongside reaches the host.
            // ---------------------------------------------------------------------------------------------------------------------------
            // |       | ⌘⇧4  |       | F1  | F2  | F3  | F4  | F5  |               | F6  | F7  | F8  | F9  | F10 | F11 | F12 | FWD DEL     |
            // | ⌘⇧5   | ⌘⇧3  |       | ⌘`  | ^↑  |⌘TAB |     |     |               |HOME |PGDN |PGUP | END |     |     |     |             |
            //         |              |CAPSW | ^←  | ^↓  | ^→  |     |     |        |  ←  |  ↓  |  ↑  |  →  |     |     |                 |
            // |       |      |       |     |     |     |     |     | MUTE | | PLAY |     |     |     |     |     |     |     |             |
            //                                    |     |⌘SPC | [nav] |             |     |⌘SPC | FWD DEL |     (⌘Space = Spotlight)

            bindings = <
&trans          &kp LG(LS(N4))  &trans      &kp F1         &kp F2      &kp F3       &kp F4  &kp F5                            &kp F6    &kp F7     &kp F8     &kp F9     &kp F10  &kp F11  &kp F12  &kp DEL
&kp LG(LS(N5))  &kp LG(LS(N3))  &trans      &kp LG(GRAVE)  &kp LC(UP)  &kp LG(TAB)  &trans  &trans                            &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans   &trans   &trans   &trans
                &trans          &caps_word  &kp LC(LEFT)   &kp LC(DOWN) &kp LC(RIGHT) &trans &trans                           &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans   &trans   &trans
&trans          &trans          &trans      &trans         &trans      &trans       &trans  &trans  &kp C_MUTE    &kp C_PP    &trans    &trans     &trans     &trans     &trans   &trans   &trans   &trans
                                                                       &trans  &kp LG(SPACE)  &trans                          &trans  &kp LG(SPACE)  &kp DEL
            >;

            sensor-bindings = <&enc_scroll SCRL_RIGHT SCRL_LEFT>, <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        mouse_layer {
            display-name = "mouse";

            // Hold the inner right thumb. Pointer on WASD under the left hand, clicks on
            // the left thumbs, scrolling on the encoders (left = up/down, right = left/right).
            // ---------------------------------------------------------------------------------------------------------------------------
            // |       |      |       |     | W↑  |     |     |     |               |     |     |     |     |     |     |     |             |
            //         |              |      | A←  | S↓  | D→  |MCLK |     |        |     |     |     |     |     |     |                 |
            // |       |      |       |     |     |     |     |     | MUTE | | PLAY | MB4 | MB5 |     |     |     |     |     |             |
            //                                    |RCLK |LCLK |       |             |[mouse]|   |      |

            bindings = <
&trans  &trans  &trans  &trans          &trans          &trans           &trans     &trans                            &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans     &trans                            &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MCLK  &trans                            &trans    &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans          &trans           &trans     &trans  &kp C_MUTE    &kp C_PP    &mkp MB4  &mkp MB5  &trans  &trans  &trans  &trans  &trans  &trans
                                                                         &mkp RCLK  &mkp LCLK  &trans                 &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&enc_scroll SCRL_RIGHT SCRL_LEFT>;
        };

        adjust_layer {
            display-name = "adjust";

            // nav + mouse held together.
            // ---------------------------------------------------------------------------------------------------------------------------
            // | BOOT  |RESET |       | BT1 | BT2 | BT3 | BT4 | BT5 |               | BRI-| BRI+|     |     |PREV |PLAY |NEXT | BOOT        |
            // |BT CLR |BT CLR ALL|   |     |     |     |     |     |               | USB | BLE | TOG |     |     |     |     |             |
            //         |              | CAPS |     |     |     |     |GAME |        |     |     |     |LOCK |     |     |                 |
            // |       |      |       |     |     |     |     |     | MUTE | | PLAY |     |     |     |     |     |     |     |             |

            bindings = <
&bootloader  &sys_reset       &trans    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                            &kp C_BRI_DN  &kp C_BRI_UP  &trans        &trans         &kp C_PREV  &kp C_PP  &kp C_NEXT  &bootloader
&bt BT_CLR   &bt BT_CLR_ALL   &trans    &trans        &trans        &trans        &trans        &trans                                  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans         &trans      &trans    &trans      &trans
             &trans           &kp CAPS  &trans        &trans        &trans        &trans        &tog GAME                               &trans        &trans        &trans        &kp LG(LC(Q))  &trans      &trans    &trans
&trans       &trans           &trans    &trans        &trans        &trans        &trans        &trans        &kp C_MUTE    &kp C_PP    &trans        &trans        &trans        &trans         &trans      &trans    &trans      &trans
                                                                                  &trans  &trans  &trans                                &trans  &trans  &trans
            >;

            sensor-bindings = <&enc_scroll SCRL_UP SCRL_DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
